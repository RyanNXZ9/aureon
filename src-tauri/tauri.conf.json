{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auréon",
  "version": "0.1.1",
  "identifier": "com.celestial.aureon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auréon — Criado por ryan ",
        "width": 1024,
        "height": 740,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#101322",
        "additionalBrowserArgs": "--disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
